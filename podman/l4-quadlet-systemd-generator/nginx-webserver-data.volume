# L4: Quadlet Volume file — defines a named Podman volume managed by systemd
# Quadlet generates a systemd service that creates this volume before containers need it
#
# Install: cp nginx-webserver-data.volume ~/.config/containers/systemd/
# Activate: systemctl --user daemon-reload
# The volume is created automatically when nginx-webserver.service starts

[Volume]
# Volume label for SELinux (z = shared, Z = private)
Label=app=nginx-webserver

# Driver: local (default) — uses host filesystem
Driver=local

# Optional: custom mount options (e.g., tmpfs, nfs)
# Options=type=tmpfs,tmpfs-size=512M
