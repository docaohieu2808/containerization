# L4: web container in the pod. Listens on 8080 inside the pod.
[Unit]
Description=Demo stack: web

[Container]
ContainerName=app-web
Pod=app.pod
Image=docker.io/nginxinc/nginx-unprivileged:1.30.6-alpine3.24
AutoUpdate=registry
ReadOnly=true
Tmpfs=/tmp
DropCapability=ALL
NoNewPrivileges=true
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/
HealthInterval=30s
HealthStartPeriod=5s

[Service]
Restart=always
TimeoutStartSec=300
